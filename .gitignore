# ===========================================
# AI ADAPTIVE STUDY BUDDY — ROOT .gitignore
# ===========================================

# ──────────────── SECRETS ────────────────
.env
.env.local
.env.*.local
*.env

# ──────────────── PYTHON ────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.eggs/
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
.Python
pyvenv.cfg

# pytest / test artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
nosetests.xml
test-results/
tests/__pycache__/

# SQLite test databases
*.db
*.sqlite
*.sqlite3

# ──────────────── NODE / FRONTEND ────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
frontend/dist/
frontend/dist-ssr/

# Vite cache
frontend/node_modules/.vite/
frontend/node_modules/.tmp/

# ──────────────── UPLOADS / DATA ────────────────
backend/uploads/
uploads/

# ──────────────── EDITORS ────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ──────────────── LOGS ────────────────
logs/
*.log
